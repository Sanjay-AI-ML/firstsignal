# Copy to .env.local and fill from your own Clerk application. Never commit real secrets.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
FIRSTSIGNAL_ORIGIN=http://127.0.0.1:5173

# Optional email; leave blank until a sender domain is verified.
RESEND_API_KEY=
EMAIL_FROM=
# Separate random bearer secret (32-256 characters) for the scheduled dispatch POST.
NOTIFICATION_DISPATCH_SECRET=
# Resend webhook signing secret. Subscribe only to transactional email lifecycle events.
RESEND_WEBHOOK_SECRET=

# Owner-only admin access: exact raw Clerk user ID (user_...), never an email.
# Leave blank to deny admin access to every account.
FINDIN_ADMIN_USER_ID=
